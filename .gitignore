# ==========================================
# Arduino & C/C++ Build Outputs & Artifacts
# ==========================================
# Compiled object files
*.o
*.obj
*.ko
*.lib
*.a

# Precompiled headers
*.gch
*.pch

# Compiled binaries and firmware images
*.elf
*.hex
*.bin
*.hex
*.eep
*.map
*.sym
*.lst

# Arduino temporary build folders (IDE build outputs)
build/
core/
applet/
.build/

