# Operating System Junk
# ==========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux / Android temporary files
*~
.directory
.trash/

# ==========================================
# Editors & IDEs Configurations
# ==========================================
